generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  hashedPassword         String?
  image                  String?
  role                   Role                    @default(TENANT)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  status                 UserStatus              @default(ACTIVE)
  serviceProviderProfile ServiceProviderProfile?
  tenantProfile          TenantProfile?
}

model TenantProfile {
  id                  String              @id @default(cuid())
  userId              String              @unique
  phone               String              @unique
  isStudent           Boolean             @default(false)
  matricNumber        String?
  studentIdUrl        String?
  schoolName          String?
  department          String?
  faculty             String?
  courseOfStudy       String?
  schoolYear          String?
  permanentAddress    String?
  governmentIdUrl     String?
  guarantorName       String?
  guarantorPhone      String?
  guarantorAddress    String?
  guarantorRelationship String?
  workType            String?
  workAddress         String?
  companyName         String?
  workIdUrl           String?
  roomId              String?
  rentStartDate       DateTime?
  rentExpiryDate      DateTime?
  allowPartialPayment Boolean             @default(false)
  rulesSigned       Boolean             @default(false)
  rulesSignedAt     DateTime?
  rulesSignedName   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  guarantorIdUrl      String?
  inspections         Inspection[]
  tickets             MaintenanceTicket[]
  payments            Payment[]
  stayHistory         StayHistory[]
  room                Room?               @relation("RoomToTenants", fields: [roomId], references: [id])
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceProviderProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  phone           String              @unique
  specialty       String
  availability    String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  assignedTickets MaintenanceTicket[]
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Block {
  id          String   @id @default(cuid())
  name        String   @unique
  address     String?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]
  billingRules BillingRule[]
}

model Room {
  id           String         @id @default(cuid())
  roomNumber   String
  status       RoomStatus     @default(AVAILABLE)
  rentAmount   Float
  capacity     Int            @default(4)
  blockId      String?
  imageUrl     String?
  photos       String[]
  rentExpiryDate DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  block        Block?         @relation(fields: [blockId], references: [id])
  billingRules   BillingRule[]  @relation("RoomToBillingRules")
  specificRules  BillingRule[]  @relation("SpecificRoomRules")
  inspections    Inspection[]
  tenants        TenantProfile[] @relation("RoomToTenants")
  stayHistory    StayHistory[]

  @@unique([blockId, roomNumber])
}

model StayHistory {
  id        String        @id @default(cuid())
  tenantId  String
  roomId    String
  startDate DateTime      @default(now())
  endDate   DateTime?
  status    String        @default("COMPLETED") // COMPLETED, ACTIVE
  createdAt DateTime      @default(now())
  room      Room          @relation(fields: [roomId], references: [id])
  tenant    TenantProfile @relation(fields: [tenantId], references: [id])
}

model Payment {
  id         String        @id @default(cuid())
  amount     Float
  receiptUrl String?
  isPartial  Boolean       @default(false)
  tenantId   String
  createdAt  DateTime      @default(now())
  reference  String?       @unique
  status     String?       @default("PENDING")
  tenant     TenantProfile @relation(fields: [tenantId], references: [id])
}

model MaintenanceTicket {
  id               String                  @id @default(cuid())
  issueDescription String
  status           MaintenanceStatus       @default(OPEN)
  roomId           String
  tenantId         String
  providerId       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  category         TicketCategory          @default(MAINTENANCE)
  tenantRating     Int?
  tenantFeedback   String?
  provider         ServiceProviderProfile? @relation(fields: [providerId], references: [id])
  tenant           TenantProfile           @relation(fields: [tenantId], references: [id])
  messages         TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  senderRole Role
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  ticket    MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Inspection {
  id        String           @id @default(cuid())
  date      DateTime         @default(now())
  status    InspectionStatus @default(PENDING)
  notes     String?
  feePaid   Boolean          @default(false)
  tenantId  String
  roomId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  room      Room             @relation(fields: [roomId], references: [id])
  tenant    TenantProfile    @relation(fields: [tenantId], references: [id])
}

// RuleType enum removed to support custom types

enum RuleFrequency {
  ONCE
  DAILY
  MONTHLY
  QUARTERLY
  YEARLY
  PER_SEMESTER
}

model BillingRule {
  id          String   @id @default(cuid())
  description String
  amount      Float
  type        String   @default("ADDITIONAL_CHARGE")
  frequency   RuleFrequency @default(ONCE)
  isGlobal    Boolean  @default(false)
  roomId      String?
  blockId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  room        Room?    @relation("SpecificRoomRules", fields: [roomId], references: [id])
  block       Block?   @relation(fields: [blockId], references: [id])
  rooms       Room[]   @relation("RoomToBillingRules")
}

model GuestInspection {
  id         String           @id @default(cuid())
  name       String
  email      String
  phone      String?
  date       DateTime
  status     InspectionStatus @default(PENDING)
  notes      String?
  feePaid    Boolean          @default(false)
  paymentRef String?          @unique
  amountPaid Float?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model SetupToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

enum Role {
  LANDLORD
  TENANT
  SERVICE_PROVIDER
  ADMIN
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  EXPIRED_RENT
  UNDER_MAINTENANCE
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketCategory {
  MAINTENANCE
  COMPLAINT
  DISPUTE
  OTHER
}

enum InspectionStatus {
  PENDING
  PASSED
  FAILED
}

enum UserStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_MADE
  ACTIVE
  REJECTED
}
